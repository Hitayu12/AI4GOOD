# Rutgers AI4Good 2026 — Production Environment Configuration
# Copy this file to .env before starting the production stack

# Server Port Mappings
FRONTEND_PORT=80
BACKEND_PORT=8000

# CORS Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# SQLite Database Location (Must point to durable volume mount /data)
DATABASE_URL=sqlite:////data/ai4good.db

# Security & Authentication
# Generate a cryptographically random secret in production (e.g., openssl rand -hex 32)
SECRET_KEY=replace_with_64_character_hex_string_for_production_security
SESSION_TIMEOUT_SECONDS=86400

# External AI Provider (Optional)
# If empty, Tutor runs in honest disabled state (503 tutor_unavailable) for live AI,
# while deterministic curriculum concept engine remains fully functional (0 model calls).
AI_PROVIDER_API_KEY=

# Node / Vite Build Parameters
VITE_API_BASE_URL=/api/v1
VITE_USE_FIXTURES=false
