# Export this in your shell; automatic .env loading is not enabled.
AI4GOOD_APP_NAME=AI4Good API
DATABASE_URL=sqlite:///./ai4good.db
AUTH_TOKEN_TTL_SECONDS=3600
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=60
# Comma-separated explicit frontend origins; empty disables cross-origin access.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

